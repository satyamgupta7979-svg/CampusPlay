        },
        {
          "name": "Get Tournament By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tournaments/:id", "host": ["{{baseUrl}}"], "path": ["tournaments", ":id"] }
          }
        },
        {
          "name": "Create Tournament (Organizer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
