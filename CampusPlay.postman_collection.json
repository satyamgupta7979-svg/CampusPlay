          "name": "Get Tournament Teams",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tournaments/:id/teams", "host": ["{{baseUrl}}"], "path": ["tournaments", ":id", "teams"] }
          }
        },
        {
          "name": "Get Tournament Fixtures",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tournaments/:id/fixtures", "host": ["{{baseUrl}}"], "path": ["tournaments", ":id", "fixtures"] }
          }
        }
      ]
    },
